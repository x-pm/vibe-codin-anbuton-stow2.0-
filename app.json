{
  "expo": {
    "name": "俺不囤",
    "slug": "stow-expo",
    "scheme": "stow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.stow.archive",
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "用于拍照识别物品，以便快速录入物品信息。",
        "NSPhotoLibraryUsageDescription": "用于从相册选择物品照片并识别、录入。",
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "系统相机组件可能申请麦克风权限。当前版本仅用于拍照识别物品，不会录制声音。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "app.stow.archive",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "用于拍照识别物品，以便快速录入物品信息。",
          "microphonePermission": "系统相机组件可能申请麦克风权限。当前版本仅用于拍照识别物品，不会录制声音。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许访问相册以选择物品照片并进行识别录入。"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5cf221f7-507c-4536-99d6-0ce17abe0425"
      }
    },
    "owner": "wuhu666"
  }
}
